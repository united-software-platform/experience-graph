# Application
PROJECT_DIR=/app
CLAUDE_CONFIG_DIR=/home/claude/.claude
CLAUDE_ACCOUNTS_DIR=.claude-accounts
CONTAINER_SSH_DIR=/home/claude/.ssh
SSH_DIR=.ssh
SSH_KEY=.ssh/id_ed25519
SSH_CONFIG=.ssh/config'nj
SSH_KNOWN_HOSTS=.ssh/known_hosts
GIT_HOST=
GIT_USER=git
USER_ID=1000
GROUP_ID=1000
#ArangoDB
ARANGO_HOST=arangodb
ARANGO_PORT=8529
# Имя базы: единый источник истины для MCP-сервера и инициализации по схеме
ARANGO_DB=experience_graph
ARANGO_USER=root
ARANGO_ROOT_PASSWORD=change_root_password

# Локаль сервера; применяется только при первом запуске на пустом каталоге данных
ARANGO_LANG=en_US_POSIX

# MCP-сервер ArangoDB (подключение в .mcp.json)
ARANGO_URL=http://arangodb:8529
ARANGO_BACKUP_ROOT=/app/data/arangodb-backups
# Версия npm-пакета arango-server и тег образа MCP-сервера
MCP_ARANGO_VERSION=0.6.1
MCP_HTTP_PORT=8000
# Адрес MCP-сервера для .mcp.json: имя сервиса в сети compose и порт MCP_HTTP_PORT.
# Значение литеральное — при смене MCP_HTTP_PORT порт правится здесь же
MCP_ARANGO_URL=http://mcp-arangodb:8000/mcp

AGENT_RUNNER_PORT=11900
AGENT_RUNNER_URL=http://host.docker.internal:11900
AGENT_RUNNER_TOKEN=change_runner_toker

